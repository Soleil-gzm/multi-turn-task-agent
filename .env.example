# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交
# 任何 OpenAI 兼容服务均可：OpenAI / DeepSeek / 通义千问(DashScope compatible-mode) / Moonshot / 智谱 / SiliconFlow / 本地 vLLM、Ollama 等

MTA_LLM=openai_compat

# 云端 API 示例（DeepSeek）
MTA_LLM_BASE_URL=https://api.deepseek.com/v1
MTA_LLM_API_KEY=sk-your-key
MTA_LLM_MODEL=deepseek-chat

# 自部署示例（vLLM / SGLang）
# MTA_LLM_BASE_URL=http://127.0.0.1:8000/v1
# MTA_LLM_API_KEY=EMPTY
# MTA_LLM_MODEL=Qwen2.5-7B-Instruct

# 自部署示例（Ollama，key 可填任意占位）
# MTA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MTA_LLM_API_KEY=ollama
# MTA_LLM_MODEL=qwen2.5:7b

# 可选采样/超时参数（评测建议 temperature=0）
# MTA_LLM_TEMPERATURE=0
# MTA_LLM_TOP_P=1
# MTA_LLM_SEED=42
# MTA_LLM_TIMEOUT=60
# MTA_LLM_MAX_TOKENS=1024
